generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      String   @default("PATIENT")
  name      String?
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor?
  patient Patient?
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String?  @default("Building2")
  headDoctor  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]
}

model Doctor {
  id              String      @id @default(uuid())
  userId          Int         @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  specialization  String
  qualification   String
  experienceYears Int         @default(0)
  consultationFee Float       @default(500)
  roomNo          String?
  workingHours    String      @default("09:00 AM - 05:00 PM")
  isAvailable     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  admissions     Admission[]
  labReports     LabReport[]
}

model Patient {
  id                   String    @id @default(uuid())
  userId               Int?      @unique
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientCode          String    @unique
  name                 String
  email                String?
  phone                String
  dateOfBirth          DateTime?
  age                  Int?
  gender               String
  bloodGroup           String?
  address              String?
  emergencyContactName String?
  emergencyContactPhone String?
  allergies            String?
  chronicConditions    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  admissions     Admission[]
  bills          Bill[]
  labReports     LabReport[]
}

model Appointment {
  id                String   @id @default(uuid())
  appointmentNumber String   @unique
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  appointmentDate   DateTime
  timeSlot          String
  type              String   @default("CONSULTATION")
  status            String   @default("PENDING")
  reason            String
  symptoms          String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  medicalRecords MedicalRecord[]
  bills          Bill[]
}

model MedicalRecord {
  id            String    @id @default(uuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recordDate    DateTime  @default(now())
  diagnosis     String
  symptoms      String?
  vitalsBp      String?
  vitalsPulse   String?
  vitalsTemp    String?
  vitalsWeight  String?
  doctorNotes   String?
  followUpDate  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prescriptions Prescription[]
}

model Prescription {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  notes           String?
  createdAt       DateTime      @default(now())

  items PrescriptionItem[]
}

model PrescriptionItem {
  id             String        @id @default(uuid())
  prescriptionId String
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName   String
  dosage         String
  frequency      String
  durationDays   Int
  instructions   String?
}

model Room {
  id          String   @id @default(uuid())
  roomNumber  String   @unique
  floor       Int      @default(1)
  roomType    String   @default("GENERAL")
  dailyRate   Float
  totalBeds   Int      @default(1)
  createdAt   DateTime @default(now())

  beds Bed[]
}

model Bed {
  id         String    @id @default(uuid())
  bedNumber  String    @unique
  roomId     String
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status     String    @default("AVAILABLE")
  createdAt  DateTime  @default(now())

  admissions Admission[]
}

model Admission {
  id                String    @id @default(uuid())
  admissionCode     String    @unique
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bedId             String
  bed               Bed       @relation(fields: [bedId], references: [id])
  attendingDoctorId String
  attendingDoctor   Doctor    @relation(fields: [attendingDoctorId], references: [id])
  admissionDate     DateTime  @default(now())
  dischargeDate     DateTime?
  reason            String
  status            String    @default("ADMITTED")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bills Bill[]
}

model Medicine {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  genericName   String?
  category      String
  manufacturer  String?
  dosageForm    String   @default("TABLET")
  stock         Int      @default(0)
  minStockAlert Int      @default(10)
  unitPrice     Float
  expiryDate    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prescriptionItems PrescriptionItem[]
}

model Bill {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  admissionId   String?
  admission     Admission?   @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float     @default(0)
  taxRate       Float     @default(5.0)
  taxAmount     Float     @default(0)
  discount      Float     @default(0)
  totalAmount   Float     @default(0)
  paidAmount    Float     @default(0)
  status        String    @default("UNPAID")
  paymentMethod String    @default("CASH")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items BillItem[]
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  category    String   @default("OTHER")
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
}

model LabTest {
  id               String   @id @default(uuid())
  testCode         String   @unique
  testName         String
  category         String
  sampleType       String   @default("Blood")
  cost             Float
  turnaroundHours  Int      @default(24)
  description      String?
  createdAt        DateTime @default(now())

  reports LabReport[]
}

model LabReport {
  id            String    @id @default(uuid())
  reportCode    String    @unique
  labTestId     String
  labTest       LabTest   @relation(fields: [labTestId], references: [id])
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  testDate      DateTime  @default(now())
  resultSummary String?
  findings      String?
  normalRange   String?
  status        String    @default("REQUESTED")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
