erDiagram
    USER {
        int id PK
        string username
        string email UK
        string password
        string role
        string name
        string phone
        string avatar
        datetime createdAt
        datetime updatedAt
    }

    DEPARTMENT {
        uuid id PK
        string name UK
        string code UK
        string description
        string icon
        string headDoctor
        datetime createdAt
        datetime updatedAt
    }

    DOCTOR {
        uuid id PK
        int userId FK,UK
        uuid departmentId FK
        string specialization
        string qualification
        int experienceYears
        float consultationFee
        string roomNo
        string workingHours
        boolean isAvailable
        datetime createdAt
        datetime updatedAt
    }

    PATIENT {
        uuid id PK
        int userId FK,UK
        string patientCode UK
        string name
        string email
        string phone
        datetime dateOfBirth
        int age
        string gender
        string bloodGroup
        string address
        string emergencyContactName
        string emergencyContactPhone
        string allergies
        string chronicConditions
        datetime createdAt
        datetime updatedAt
    }

    APPOINTMENT {
        uuid id PK
        string appointmentNumber UK
        uuid patientId FK
        uuid doctorId FK
        uuid departmentId FK
        datetime appointmentDate
        string timeSlot
        string type
        string status
        string reason
        string symptoms
        string notes
        datetime createdAt
        datetime updatedAt
    }

    MEDICAL_RECORD {
        uuid id PK
        uuid patientId FK
        uuid doctorId FK
        uuid appointmentId FK
        datetime recordDate
        string diagnosis
        string symptoms
        string vitalsBp
        string vitalsPulse
        string vitalsTemp
        string vitalsWeight
        string doctorNotes
        datetime followUpDate
        datetime createdAt
        datetime updatedAt
    }

    PRESCRIPTION {
        uuid id PK
        uuid medicalRecordId FK
        uuid patientId FK
        uuid doctorId FK
        string notes
        datetime createdAt
    }

    PRESCRIPTION_ITEM {
        uuid id PK
        uuid prescriptionId FK
        uuid medicineId FK
        string medicineName
        string dosage
        string frequency
        int durationDays
        string instructions
    }

    MEDICINE {
        uuid id PK
        string code UK
        string name
        string genericName
        string category
        string manufacturer
        string dosageForm
        int stock
        int minStockAlert
        float unitPrice
        datetime expiryDate
        datetime createdAt
        datetime updatedAt
    }

    ROOM {
        uuid id PK
        string roomNumber UK
        int floor
        string roomType
        float dailyRate
        int totalBeds
        datetime createdAt
    }

    BED {
        uuid id PK
        string bedNumber UK
        uuid roomId FK
        string status
        datetime createdAt
    }

    ADMISSION {
        uuid id PK
        string admissionCode UK
        uuid patientId FK
        uuid bedId FK
        uuid attendingDoctorId FK
        datetime admissionDate
        datetime dischargeDate
        string reason
        string status
        string notes
        datetime createdAt
        datetime updatedAt
    }

    BILL {
        uuid id PK
        string invoiceNumber UK
        uuid patientId FK
        uuid appointmentId FK
        uuid admissionId FK
        datetime issueDate
        datetime dueDate
        float subtotal
        float taxRate
        float taxAmount
        float discount
        float totalAmount
        float paidAmount
        string status
        string paymentMethod
        string notes
        datetime createdAt
        datetime updatedAt
    }

    BILL_ITEM {
        uuid id PK
        uuid billId FK
        string description
        string category
        int quantity
        float unitPrice
        float totalPrice
    }

    LAB_TEST {
        uuid id PK
        string testCode UK
        string testName
        string category
        string sampleType
        float cost
        int turnaroundHours
        string description
        datetime createdAt
    }

    LAB_REPORT {
        uuid id PK
        string reportCode UK
        uuid labTestId FK
        uuid patientId FK
        uuid doctorId FK
        datetime testDate
        string resultSummary
        string findings
        string normalRange
        string status
        datetime createdAt
        datetime updatedAt
    }

    USER ||--o| DOCTOR : "authenticates as"
    USER ||--o| PATIENT : "authenticates as"

    DEPARTMENT ||--o{ DOCTOR : "employs"
    DEPARTMENT ||--o{ APPOINTMENT : "categorizes"

    DOCTOR ||--o{ APPOINTMENT : "conducts"
    PATIENT ||--o{ APPOINTMENT : "schedules"

    PATIENT ||--o{ MEDICAL_RECORD : "subject of"
    DOCTOR ||--o{ MEDICAL_RECORD : "records"
    APPOINTMENT ||--o| MEDICAL_RECORD : "originates from"

    MEDICAL_RECORD ||--o{ PRESCRIPTION : "generates"
    PATIENT ||--o{ PRESCRIPTION : "receives"
    DOCTOR ||--o{ PRESCRIPTION : "prescribes"

    PRESCRIPTION ||--|{ PRESCRIPTION_ITEM : "contains line items"
    MEDICINE ||--o{ PRESCRIPTION_ITEM : "dispensed in"

    ROOM ||--|{ BED : "contains"
    BED ||--o{ ADMISSION : "assigned to"
    PATIENT ||--o{ ADMISSION : "admitted as"
    DOCTOR ||--o{ ADMISSION : "attending physician for"

    PATIENT ||--o{ BILL : "billed to"
    APPOINTMENT ||--o| BILL : "billed from OPD"
    ADMISSION ||--o| BILL : "billed from IPD"
    BILL ||--|{ BILL_ITEM : "contains itemized charges"

    LAB_TEST ||--o{ LAB_REPORT : "specifies catalog parameters for"
    PATIENT ||--o{ LAB_REPORT : "subject of"
    DOCTOR ||--o{ LAB_REPORT : "prescribed by"

